# Copie este arquivo para .env (ou exporte as variaveis direto no terminal) e
# preencha com sua chave. NUNCA commite o .env de verdade no Git.

# Provedor padrao deste projeto: Google Gemini
# Gere uma chave gratuita em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Opcional: forcar um modelo especifico do Gemini (padrao: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# Opcional: por quanto tempo (ms) reaproveitar a ultima mensagem gerada pelo LLM
# quando o nivel de prioridade nao mudou, antes de chamar o LLM de novo (padrao: 60000 = 1 min)
# VITALIS_VOICE_COOLDOWN_MS=60000

# Alternativa: Anthropic Claude, caso prefira trocar de provedor
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
